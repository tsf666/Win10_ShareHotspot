<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 带 Windows SDK 版本号的 TFM:自动获得 WinRT 投影,可直接 using Windows.Networking.* -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    
    <LangVersion>latest</LangVersion>
    <AssemblyName>Win10ShareHotspot</AssemblyName>
    <RootNamespace>Win10ShareHotspot</RootNamespace>

    <!-- 应用图标 -->
  <ApplicationIcon>Win 10 Share Hotspot.ico</ApplicationIcon>
  <!-- 单文件打包设置 -->
  <PublishSingleFile>true</PublishSingleFile>

  <!-- 作者/版权信息,会被写进 exe 的文件属性里 -->
  <Authors>Stephen Tam</Authors>
  <Company>HKIIT 2526</Company>
  <Product>Win 10 共享热点工具</Product>
  <Copyright>Copyright © 2026 Stephen Tam. Licensed under the MIT License.</Copyright>
  <Version>0.0.1</Version>
  <AssemblyVersion>0.0.0.1</AssemblyVersion>
  <FileVersion>0.0.0.1</FileVersion>
  <Description>Win 10 Share Hotspot 一个用于开关电脑热点、查看已连接设备的小工具</Description>
    
  </PropertyGroup>

</Project>
